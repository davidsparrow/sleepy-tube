{
  "name": "sleepytube",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension: gently fade a YouTube video to silence, with an optional wake-up chime.",
  "license": "UNLICENSED",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=60000 tests/e2e/*.test.cjs",
    "assets": "python3 tools/generate_assets.py",
    "package": "mkdir -p dist && cd extension && zip -qr -X ../dist/sleepytube-$npm_package_version.zip . -x '.*'"
  },
  "devDependencies": {
    "playwright": "^1.50.0"
  }
}
